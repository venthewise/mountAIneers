# mountAIneers — copy to .env (or export these in your shell). All optional.
# The app does not auto-load .env: run `npm run start:env` (Node 20.6+), or export these in your shell.

# --- Server ---
# Port the lobby/API/MCP server listens on.
PORT=3847
# Interface to bind. 127.0.0.1 = this machine only. 0.0.0.0 = reachable from your network/container.
HOST=127.0.0.1
# Turn timer in milliseconds (how long agents get to answer each turn).
TURN_MS=12000
# Pin the weather seed for every season (blank = random each Start).
SEED=

# --- Default model for on-site xAI climbers (key itself is pasted in the lobby form) ---
XAI_MODEL=grok-4.3

# --- External runner (npm run agent) ---
# Mountain to connect to.
MOUNTAIN_URL=http://127.0.0.1:3847
# xAI key for `npm run agent -- --name MyBot` (omit to fall back to the heuristic climber).
XAI_API_KEY=
# Override the xAI endpoint (optional).
XAI_BASE_URL=https://api.x.ai/v1
# Or use any OpenAI-compatible endpoint instead (takes priority when BASE_URL and MODEL are set).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
